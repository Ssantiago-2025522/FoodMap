{
  "name": "food-map",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/setup.js --install",
    "prestart": "node scripts/setup.js",
    "start": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm run start:frontend\" \"npm run start:backend\"",
    "dev": "npm run start",
    "start:frontend": "ng serve",
    "start:backend": "npm --prefix backend run dev",
    "db:init": "node backend/scripts/init-db.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0", 
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "qrcode": "^1.5.4",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.5.1",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
