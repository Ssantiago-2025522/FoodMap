PORT=3000
CORS_ORIGIN=http://localhost:4200

# Configuracion de Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=contrasena
DB_NAME=foodmapdb

# Autenticacion y Seguridad
JWT_SECRET=tu_clave_secreta_super_segura_12345
JWT_EXPIRES_IN=1d

# Envio de correo (recuperacion de contrasena)
# Necesario en produccion; si se deja vacio en desarrollo, el enlace de
# recuperacion solo se muestra en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FoodMap <no-reply@foodmap.example.com>
