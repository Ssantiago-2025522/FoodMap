PORT=3000
CORS_ORIGIN=http://localhost:4200

# Configuracion de Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_db
DB_NAME=foodmapdb_in

# Autenticacion y Seguridad
# Genera un valor propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_esto_con_un_valor_aleatorio_largo
JWT_EXPIRES_IN=1d

# Envio de correo (recuperacion de contrasena)
# Necesario en produccion; si se deja vacio en desarrollo, el enlace de
# recuperacion solo se muestra en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FoodMap <no-reply@foodmap.example.com>